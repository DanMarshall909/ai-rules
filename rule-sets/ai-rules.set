# ai-rules — the base set every project gets.
#
# Order is reading order: authority frames the policy; reflection closes.
# A set with no `layer:` is a base set; it stands on its own.

title: AI Rules
blurb: Lean, agent-agnostic rules for any coding assistant.

rule: authority
rule: sync
rule: breaks
rule: tdd
rule: coverage
rule: guardrails
rule: security
rule: git
rule: issues
rule: reflection

skill: agentic-delivery
skill: behavior-first-tdd
skill: coverage-and-mutation
skill: security-by-design
skill: break-reminders
skill: reflect
skill: adopt-ai-rules
skill: upgrade-global-skills
skill: make-repository-skills-portable
