#!/usr/bin/env bash
# pre-commit — enable with:  git config core.hooksPath scripts/hooks
#
# AGENTS.md and rule-sets/ai-rules.md are generated from rules/*.md, and every
# project that installed the rules reads them through symlinks. So editing a
# rule and not regenerating quietly serves the old rule until someone pushes and
# CI says so.
#
# This is that check, moved to the point where it is cheap to fix.

set -uo pipefail

cd "$(git rev-parse --show-toplevel)" || exit 1

status=0
git_dir="$(git rev-parse --absolute-git-dir)" || exit 1
staged="$(mktemp -d)" || exit 1
cleanup() { rm -rf "${staged}"; }
trap cleanup EXIT HUP INT TERM

# Hooks run beside the working tree, but Git commits the index. Export that
# exact snapshot so an unstaged authored change cannot make a staged generated
# file look current. Point Git-aware convention checks back at the real index
# while they read file contents from the exported tree.
if ! git checkout-index --all --prefix="${staged}/"; then
  echo "pre-commit: could not inspect the staged snapshot." >&2
  exit 1
fi

staged_check() {
  (
    cd "${staged}" || exit 1
    GIT_DIR="${git_dir}" GIT_WORK_TREE="${staged}" "$@"
  )
}

if ! staged_check scripts/build-agents.sh --check >/dev/null 2>&1; then
  echo "pre-commit: generated rule files are stale." >&2
  echo "  run scripts/build-agents.sh and stage the result" >&2
  status=1
fi

if ! staged_check scripts/check-conventions.sh >/dev/null 2>&1; then
  echo "pre-commit: a repo convention is broken." >&2
  staged_check scripts/check-conventions.sh 2>&1 >/dev/null | sed 's/^/  /' >&2
  status=1
fi

# The test suites are CI's job: they take long enough that running them on every
# commit would teach people to reach for --no-verify, which costs more than it
# saves.

exit ${status}
