{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Repository .ai-rules.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "resources"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "enum": [
        1,
        2
      ]
    },
    "resources": {
      "type": "object",
      "required": [
        "memory"
      ],
      "properties": {
        "memory": {
          "type": "object",
          "required": [
            "reserveMiBPerActiveWorktree",
            "basis"
          ],
          "additionalProperties": false,
          "properties": {
            "reserveMiBPerActiveWorktree": {
              "type": "integer",
              "minimum": 1
            },
            "basis": {
              "enum": [
                "measured",
                "estimated"
              ]
            },
            "observedPeakMiB": {
              "type": "integer",
              "minimum": 1,
              "description": "Ceiling of the sampled task/process-group RSS peak in MiB."
            },
            "estimateReason": {
              "type": "string",
              "minLength": 1
            },
            "measurement": {
              "type": "object",
              "required": [
                "workload",
                "date",
                "evidence"
              ],
              "additionalProperties": false,
              "properties": {
                "workload": {
                  "type": "string",
                  "minLength": 1
                },
                "date": {
                  "type": "string",
                  "format": "date"
                },
                "evidence": {
                  "type": "string",
                  "minLength": 1
                },
                "durationSeconds": {
                  "type": "integer",
                  "minimum": 1
                },
                "completedRunDurationsSeconds": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "taskConcurrency": {
                  "type": "integer",
                  "minimum": 1
                },
                "minimumAvailableMiB": {
                  "type": "integer",
                  "minimum": 0
                },
                "peakTaskSwapMiB": {
                  "type": "integer",
                  "minimum": 0
                },
                "notes": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "oneOf": [
            {
              "properties": {
                "basis": {
                  "const": "measured"
                }
              },
              "required": [
                "observedPeakMiB",
                "measurement"
              ],
              "not": {
                "required": [
                  "estimateReason"
                ]
              }
            },
            {
              "properties": {
                "basis": {
                  "const": "estimated"
                }
              },
              "required": [
                "estimateReason"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "observedPeakMiB"
                    ]
                  },
                  {
                    "required": [
                      "measurement"
                    ]
                  }
                ]
              }
            }
          ]
        },
        "disk": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "workloads"
          ],
          "properties": {
            "workloads": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "reserveMiB",
                  "outputGrowthMiB",
                  "tempGrowthMiB",
                  "retainedBudgetMiB",
                  "basis"
                ],
                "properties": {
                  "reserveMiB": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4294967296
                  },
                  "outputGrowthMiB": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967296
                  },
                  "tempGrowthMiB": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967296
                  },
                  "retainedBudgetMiB": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967296
                  },
                  "basis": {
                    "enum": [
                      "estimated",
                      "measured"
                    ]
                  },
                  "estimateReason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "measurement": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "workload",
                      "date",
                      "evidence"
                    ],
                    "properties": {
                      "workload": {
                        "type": "string",
                        "minLength": 1
                      },
                      "date": {
                        "type": "string",
                        "format": "date"
                      },
                      "evidence": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                },
                "oneOf": [
                  {
                    "properties": {
                      "basis": {
                        "const": "estimated"
                      }
                    },
                    "required": [
                      "estimateReason"
                    ],
                    "not": {
                      "required": [
                        "measurement"
                      ]
                    }
                  },
                  {
                    "properties": {
                      "basis": {
                        "const": "measured"
                      }
                    },
                    "required": [
                      "measurement"
                    ],
                    "not": {
                      "required": [
                        "estimateReason"
                      ]
                    }
                  }
                ]
              }
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "resources": {
            "not": {
              "required": [
                "disk"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 2
          }
        }
      },
      "then": {
        "properties": {
          "resources": {
            "required": [
              "disk"
            ]
          }
        }
      }
    }
  ]
}
