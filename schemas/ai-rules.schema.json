{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Repository .ai-rules.json",
  "type": "object",
  "required": ["schemaVersion", "resources"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "resources": {
      "type": "object",
      "properties": {
        "memory": {
          "type": "object",
          "required": ["reserveMiBPerActiveWorktree", "basis"],
          "additionalProperties": false,
          "properties": {
            "reserveMiBPerActiveWorktree": { "type": "integer", "minimum": 1 },
            "basis": { "enum": ["measured", "estimated"] },
            "observedPeakMiB": {
              "type": "integer",
              "minimum": 1,
              "description": "Ceiling of the sampled task/process-group RSS peak in MiB."
            },
            "estimateReason": { "type": "string", "minLength": 1 },
            "measurement": {
              "type": "object",
              "required": ["workload", "date", "evidence"],
              "additionalProperties": false,
              "properties": {
                "workload": { "type": "string", "minLength": 1 },
                "date": { "type": "string", "format": "date" },
                "evidence": { "type": "string", "minLength": 1 },
                "durationSeconds": { "type": "integer", "minimum": 1 },
                "completedRunDurationsSeconds": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "integer", "minimum": 1 }
                },
                "taskConcurrency": { "type": "integer", "minimum": 1 },
                "minimumAvailableMiB": { "type": "integer", "minimum": 0 },
                "peakTaskSwapMiB": { "type": "integer", "minimum": 0 },
                "notes": { "type": "string", "minLength": 1 }
              }
            }
          },
          "oneOf": [
            {
              "properties": { "basis": { "const": "measured" } },
              "required": ["observedPeakMiB", "measurement"],
              "not": { "required": ["estimateReason"] }
            },
            {
              "properties": { "basis": { "const": "estimated" } },
              "required": ["estimateReason"],
              "not": {
                "anyOf": [
                  { "required": ["observedPeakMiB"] },
                  { "required": ["measurement"] }
                ]
              }
            }
          ]
        }
      },
      "additionalProperties": true
    }
  }
}
